ANALYTICS_HOST=127.0.0.1
ANALYTICS_PORT=4567
# Split-process production settings. Generate a long random control token.
ANALYTICS_LOG_TO_FILE=false
ANALYTICS_RESOURCE_LOG_INTERVAL_MS=60000
ANALYTICS_CRAWLER_CONTROL_TOKEN=replace-with-random-token
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net
MONGODB_DB_NAME=owj_market_analytics
# Keep false in production; apply versioned index migrations explicitly.
MONGODB_AUTO_INDEX=false
MONGODB_RETRY_ATTEMPTS=5
MONGODB_RETRY_BASE_DELAY_MS=1000
MONGODB_RETRY_MAX_DELAY_MS=30000
NEXT_PUBLIC_NESHAN_MAP_KEY=web.your_public_web_key
# Server-only service key for Nearby Search and Pedestrian Routing. Never use
# NEXT_PUBLIC_NESHAN_MAP_KEY here; Neshan scopes browser and service keys.
NESHAN_SERVICE_KEY=your_server_services_key
# Nearby Search must be activated by Neshan support for this key.
NESHAN_NEARBY_RADIUS_METERS=1500
NESHAN_NEARBY_RESULTS_PER_LAYER=8
# Server-only OpenAI key. Never expose it through a NEXT_PUBLIC variable.
OPENAI_API_KEY=your_server_openai_key
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_FILTER_MODEL=gpt-5-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_VOICE=marin
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_CONCURRENT=2
ANALYTICS_AUTO_CRAWL=true
ANALYTICS_CRAWL_INTERVAL_MS=21600000
ANALYTICS_CRAWL_FAILURE_RETRY_MS=60000
ANALYTICS_HEADLESS=true
ANALYTICS_LISTINGS_PER_AREA=15
# On-demand neighborhood jobs are API-only, single-worker and share the main
# crawler lock. These limits keep browser-triggered refreshes memory-bounded.
ANALYTICS_TARGETED_LISTINGS_PER_AREA=15
ANALYTICS_TARGETED_MAX_REQUESTS=50
ANALYTICS_TARGETED_COOLDOWN_MS=1800000
ANALYTICS_TARGETED_QUEUE_LIMIT=10
# 0 means every Tehran area returned by Divar; set 3 for a quick test crawl.
ANALYTICS_MAX_AREAS=0
# Safety ceiling across the complete area queue.
ANALYTICS_MAX_LISTINGS=10000
ANALYTICS_JSON_SNAPSHOT_EVERY=25
ANALYTICS_DETAIL_CONCURRENCY=3
ANALYTICS_NAVIGATION_TIMEOUT_MS=60000
ANALYTICS_PUBLIC_REQUEST_INTERVAL_MS=2500
ANALYTICS_MAX_SEARCH_ITERATIONS=150
ANALYTICS_MAX_SEARCH_STALLS=5
ANALYTICS_RETRY_MAX_ATTEMPTS=3
ANALYTICS_RETRY_BASE_DELAY_MS=1000
ANALYTICS_RETRY_MAX_DELAY_MS=15000
ANALYTICS_RECOVERY_MAX_ITEMS=100
ANALYTICS_RECOVERY_ATTEMPTS=1
ANALYTICS_FRESH_DETAIL_HOURS=6
ANALYTICS_CHANGED_DETAIL_HOURS=2
ANALYTICS_STALE_DETAIL_HOURS=24
ANALYTICS_REMOVAL_MISS_THRESHOLD=3
ANALYTICS_MAX_REQUESTS_PER_RUN=15000
ANALYTICS_MAX_REQUESTS_PER_MINUTE=24
# Rebuild scoring after saved listing changes settle for this long.
ANALYTICS_LIVE_SCORING_DEBOUNCE_MS=30000
ANALYTICS_LIVE_SCORING_MIN_INTERVAL_MS=900000
# Buyer-demand search safeguards.
ANALYTICS_SEARCH_MAX_CANDIDATES=500
ANALYTICS_SEARCH_MAX_CONCURRENT=4
ANALYTICS_SEARCH_QUERY_MAX_TIME_MS=2000
ANALYTICS_MAX_OBSERVATIONS_PER_LISTING=50
ANALYTICS_MAX_LOG_BYTES=25000000
ANALYTICS_LOG_ARCHIVES=5
ANALYTICS_DEBUG_ARTIFACT_DAYS=14
ANALYTICS_MIN_SPATIAL_SAMPLE=5
ANALYTICS_SPATIAL_CELL_SIZE_METERS=1000
ANALYTICS_MIN_MODEL_SAMPLE=30
ANALYTICS_LOG_LEVEL=debug
# Optional dedicated JSONL filename inside ./logs for one crawl session.
ANALYTICS_LOG_FILE=service.jsonl

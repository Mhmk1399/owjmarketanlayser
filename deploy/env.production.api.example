# Copy to .env.production.api on the server. API-only credentials belong here.
NEXT_PUBLIC_NESHAN_MAP_KEY=replace-with-public-web-map-key
NESHAN_SERVICE_KEY=replace-with-server-service-key
OPENAI_API_KEY=replace-with-rotated-key
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_FILTER_MODEL=gpt-5-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_CONCURRENT=2


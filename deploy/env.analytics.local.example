# Synthetic local integration only. Copy to .env.analytics.local and generate
# every secret independently. Never point this file at Atlas or production.
MONGODB_URI=mongodb://owj_analytics:replace-local-password@mongo:27017/owj_analytics?authSource=owj_analytics&replicaSet=rs0
MONGODB_DB_NAME=owj_analytics
MONGODB_AUTO_INDEX=false
ANALYTICS_HOST=0.0.0.0
ANALYTICS_PORT=4567
ANALYTICS_DASHBOARD_ORIGIN=http://analytics.owj.localhost:18088
ANALYTICS_ALLOWED_REDIRECT_URIS=http://analytics.owj.localhost:18088/auth/callback
ANALYTICS_WEB_AUTHORIZE_URL=http://owj.localhost:18088/api/v1/analytics/authorize
ANALYTICS_WEB_EXCHANGE_URL=http://web:3000/api/internal/v1/analytics/exchange
ANALYTICS_WEB_STATUS_URL=http://web:3000/api/internal/v1/analytics/identity/status
ANALYTICS_TO_WEB_SERVICE_TOKEN=replace-with-32-plus-random-characters
ANALYTICS_WEB_SERVICE_TOKEN=replace-with-independent-web-to-analytics-token
ANALYTICS_CRAWLER_CONTROL_TOKEN=replace-with-independent-crawler-control-token
ANALYTICS_SESSION_SECRET=replace-with-independent-session-digest-secret
ANALYTICS_WEB_IDENTITY_ENABLED=true
ANALYTICS_ALLOW_INSECURE_LOCAL_COOKIE=true
ANALYTICS_LEGACY_HUMAN_TOKENS_ENABLED=false
ANALYTICS_AUTO_CRAWL=false


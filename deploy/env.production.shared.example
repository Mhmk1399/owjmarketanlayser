# Copy to .env.production.shared on the server. Never commit the real file.
MONGODB_URI=mongodb+srv://analytics-user:password@cluster.example.mongodb.net
MONGODB_DB_NAME=owj_market_analytics
MONGODB_AUTO_INDEX=false
MONGODB_RETRY_ATTEMPTS=5
MONGODB_RETRY_BASE_DELAY_MS=1000
MONGODB_RETRY_MAX_DELAY_MS=30000
ANALYTICS_CRAWL_INTERVAL_MS=21600000
ANALYTICS_CRAWL_FAILURE_RETRY_MS=60000
ANALYTICS_LISTINGS_PER_AREA=15
ANALYTICS_MAX_AREAS=0
ANALYTICS_MAX_LISTINGS=10000
ANALYTICS_PUBLIC_REQUEST_INTERVAL_MS=2500
ANALYTICS_MAX_REQUESTS_PER_RUN=15000
ANALYTICS_LOG_LEVEL=info


{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owj.local/schemas/public-listing.schema.json",
  "title": "Owj public market listing",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": "2.0.0" } }, "required": ["schemaVersion"] },
      "then": { "required": ["media"] }
    }
  ],
  "required": [
    "schemaVersion",
    "token",
    "url",
    "title",
    "description",
    "images",
    "attributes",
    "category",
    "subcategory",
    "city",
    "district",
    "neighborhood",
    "sourceNeighborhoodSlug",
    "resolvedLocation",
    "publishedText",
    "crawlPartition",
    "property",
    "propertyDetails",
    "pricing",
    "amenities",
    "advertiserType",
    "advertiserSignals",
    "coordinates",
    "nearbyPlaces",
    "imageCount",
    "publication",
    "locationProvenance",
    "extraction",
    "quality",
    "lifecycle",
    "firstSeenAt",
    "lastSeenAt",
    "contentFingerprint"
  ],
  "properties": {
    "schemaVersion": { "enum": ["1.0.0", "2.0.0"] },
    "token": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "url": { "type": "string", "format": "uri" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"], "maxLength": 10000 },
    "images": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["url", "width", "height", "alt", "format", "isPrimary"],
        "properties": {
          "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "width": { "type": ["integer", "null"], "minimum": 1 },
          "height": { "type": ["integer", "null"], "minimum": 1 },
          "alt": { "type": ["string", "null"] }, "format": { "type": ["string", "null"] },
          "isPrimary": { "type": "boolean" }
        }
      }
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["key", "label", "value"],
        "properties": { "key": { "type": "string" }, "label": { "type": "string" }, "value": { "type": "string" } }
      }
    },
    "category": { "type": ["string", "null"] },
    "subcategory": { "type": ["string", "null"] },
    "city": { "type": ["string", "null"] },
    "district": { "type": ["string", "null"] },
    "neighborhood": { "type": ["string", "null"] },
    "sourceNeighborhoodSlug": { "type": ["string", "null"] },
    "resolvedLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provinceId", "cityId", "neighborhoodId", "slug", "name", "matchConfidence"],
      "properties": {
        "provinceId": { "type": ["integer", "null"] },
        "cityId": { "type": ["integer", "null"] },
        "neighborhoodId": { "type": ["integer", "null"] },
        "slug": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "matchConfidence": { "enum": ["exact-slug", "exact-name", "crawl-partition", "unmatched"] }
      }
    },
    "publishedText": { "type": ["string", "null"] },
    "crawlPartition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "expectedSubcategory", "area"],
      "properties": {
        "category": { "type": ["string", "null"] },
        "expectedSubcategory": { "type": ["string", "null"] },
        "area": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["id", "name", "slug"],
          "properties": {
            "id": { "type": ["integer", "null"] },
            "name": { "type": ["string", "null"] },
            "slug": { "type": ["string", "null"] },
            "municipalDistricts": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 1, "maximum": 22 }
            }
          }
        }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area", "constructionYear", "rooms", "floor", "totalFloors", "unitsPerFloor"],
      "properties": {
        "area": { "type": ["number", "null"] },
        "constructionYear": { "type": ["integer", "null"] },
        "rooms": { "type": ["number", "null"] },
        "floor": { "type": ["number", "null"] },
        "totalFloors": { "type": ["number", "null"] },
        "unitsPerFloor": { "type": ["number", "null"] }
      }
    },
    "propertyDetails": {
      "type": "object", "additionalProperties": false,
      "required": ["deedType", "buildingDirection", "unitPosition", "propertyType", "buildingCondition", "heating", "cooling"],
      "properties": {
        "deedType": { "type": ["string", "null"] }, "buildingDirection": { "type": ["string", "null"] },
        "unitPosition": { "type": ["string", "null"] }, "propertyType": { "type": ["string", "null"] },
        "landWidth": { "type": ["string", "null"] }, "buildingDensity": { "type": ["string", "null"] },
        "buildingCondition": { "type": ["string", "null"] }, "heating": { "type": ["string", "null"] },
        "cooling": { "type": ["string", "null"] }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "price", "pricePerMeter", "deposit", "rent", "isFullMortgage", "isNegotiable"],
      "properties": {
        "currency": { "const": "TOMAN" },
        "price": { "type": ["number", "null"] },
        "pricePerMeter": { "type": ["number", "null"] },
        "deposit": { "type": ["number", "null"] },
        "rent": { "type": ["number", "null"] },
        "isFullMortgage": { "type": ["boolean", "null"] },
        "isNegotiable": { "type": ["boolean", "null"] }
      }
    },
    "amenities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elevator", "parking", "storage", "balcony", "rooftop", "lobby", "doorman", "security", "pool", "sauna", "gym", "centralAntenna", "airConditioning", "heating"],
      "properties": {
        "elevator": { "type": ["boolean", "null"] },
        "parking": { "type": ["boolean", "null"] },
        "storage": { "type": ["boolean", "null"] },
        "balcony": { "type": ["boolean", "null"] },
        "rooftop": { "type": ["boolean", "null"] }, "lobby": { "type": ["boolean", "null"] },
        "doorman": { "type": ["boolean", "null"] }, "security": { "type": ["boolean", "null"] },
        "pool": { "type": ["boolean", "null"] }, "sauna": { "type": ["boolean", "null"] },
        "gym": { "type": ["boolean", "null"] }, "centralAntenna": { "type": ["boolean", "null"] },
        "airConditioning": { "type": ["boolean", "null"] }, "heating": { "type": ["boolean", "null"] }
      }
    },
    "advertiserType": { "enum": ["personal", "real-estate-business", "unknown"] },
    "advertiserSignals": {
      "type": "object", "additionalProperties": false, "required": ["type", "isBusiness", "hasBusinessBadge"],
      "properties": {
        "type": { "enum": ["personal", "real-estate-business", "unknown"] },
        "isBusiness": { "type": ["boolean", "null"] }, "hasBusinessBadge": { "type": ["boolean", "null"] },
        "panelType": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]+$" },
        "hasBusinessReference": { "type": ["boolean", "null"] },
        "classificationSource": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "confidence": { "enum": ["high", "medium", "low"] },
        "businessDisplayName": { "type": ["string", "null"], "maxLength": 300 }
      }
    },
    "media": {
      "type": "object", "additionalProperties": false,
      "required": ["samePropertyImageClaim", "claimSource"],
      "properties": {
        "samePropertyImageClaim": { "type": ["boolean", "null"] },
        "claimSource": { "enum": ["poster-declared-public-field", null] }
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude", "accuracy", "radiusMeters", "source"],
      "properties": {
        "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "accuracy": { "type": ["string", "null"] },
        "radiusMeters": { "type": ["number", "null"], "minimum": 0 },
        "source": { "type": ["string", "null"] }
      }
    },
    "nearbyPlaces": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["category", "title", "address", "coordinates", "distanceMeters", "source", "fetchedAt"],
        "properties": {
          "category": { "enum": ["bus-station", "metro-station"] },
          "layer": { "enum": ["bus_station", "metro_entrance", null] },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "address": { "type": ["string", "null"], "maxLength": 300 },
          "coordinates": {
            "type": "object", "additionalProperties": false, "required": ["latitude", "longitude"],
            "properties": { "latitude": { "type": "number", "minimum": -90, "maximum": 90 }, "longitude": { "type": "number", "minimum": -180, "maximum": 180 } }
          },
          "distanceMeters": { "type": "number", "minimum": 0 },
          "straightLineDistanceMeters": { "type": ["number", "null"], "minimum": 0 },
          "nearbyDistanceMeters": { "type": ["number", "null"], "minimum": 0 },
          "nearbyDurationSeconds": { "type": ["number", "null"], "minimum": 0 },
          "routeDistanceMeters": { "type": ["number", "null"], "minimum": 0 },
          "routeDurationSeconds": { "type": ["number", "null"], "minimum": 0 },
          "routeMode": { "enum": ["pedestrian", null] },
          "poiHash": { "type": ["string", "null"], "maxLength": 500, "pattern": "^[A-Za-z0-9_-]+$" },
          "source": { "enum": ["neshan-search", "neshan-nearby"] },
          "fetchedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "imageCount": { "type": "integer", "minimum": 0 },
    "publication": {
      "type": "object", "additionalProperties": false, "required": ["text", "source"],
      "properties": { "text": { "type": ["string", "null"] }, "source": { "type": ["string", "null"] } }
    },
    "locationProvenance": {
      "type": "object", "additionalProperties": false, "required": ["source", "sourceNeighborhoodSlug", "crawlAreaId"],
      "properties": { "source": { "type": ["string", "null"] }, "sourceNeighborhoodSlug": { "type": ["string", "null"] }, "crawlAreaId": { "type": ["integer", "null"] } }
    },
    "extraction": {
      "type": "object", "additionalProperties": false, "required": ["source", "presentFields", "missingFields", "coveragePercent"],
      "properties": {
        "source": { "type": ["string", "null"] }, "presentFields": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "missingFields": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "coveragePercent": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "missingFields", "outcome", "outcomeReasons"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "missingFields": { "type": "array", "items": { "type": "string" } },
        "outcome": { "enum": ["scoring-ready", "history-only"] },
        "outcomeReasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "detailFetchedAt", "lastDiscoveredAt", "lastConfirmedRunId", "lastContentChangedAt", "consecutiveMisses", "removedAt"],
      "properties": {
        "status": { "enum": ["active", "not-seen", "possibly-removed", "removed"] },
        "detailFetchedAt": { "type": ["string", "null"], "format": "date-time" },
        "lastDiscoveredAt": { "type": ["string", "null"], "format": "date-time" },
        "lastConfirmedRunId": { "type": ["string", "null"] },
        "lastContentChangedAt": { "type": ["string", "null"], "format": "date-time" },
        "consecutiveMisses": { "type": "integer", "minimum": 0 },
        "removedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "firstSeenAt": { "type": "string", "format": "date-time" },
    "lastSeenAt": { "type": "string", "format": "date-time" },
    "contentFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
